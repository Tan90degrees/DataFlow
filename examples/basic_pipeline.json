{
  "api_version": "dataflow.io/v1alpha1",
  "kind": "Pipeline",
  "name": "basic-etl",
  "runtime": {
    "image": "registry.example.com/dataflow-runtime:dev",
    "ray_address": "auto",
    "namespace": "default"
  },
  "cluster_profile": "cpu-medium",
  "artifact_base_uri": "s3://example-bucket/dataflow-artifacts",
  "nodes": [
    {
      "id": "read",
      "kind": "read_parquet",
      "config": {
        "path": "s3://example-bucket/input"
      }
    },
    {
      "id": "transform",
      "kind": "map_batches",
      "config": {
        "callable": "dataflow.callables.identity"
      },
      "resources": {
        "cpu": 2
      }
    },
    {
      "id": "filter",
      "kind": "filter",
      "config": {
        "callable": "dataflow.callables.always_true"
      }
    },
    {
      "id": "write",
      "kind": "write_parquet",
      "config": {
        "path": "s3://example-bucket/output"
      }
    }
  ],
  "edges": [
    {
      "from": "read",
      "to": "transform",
      "kind": "data"
    },
    {
      "from": "transform",
      "to": "filter",
      "kind": "data"
    },
    {
      "from": "filter",
      "to": "write",
      "kind": "data"
    }
  ]
}
