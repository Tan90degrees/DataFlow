FROM alpine:3.22

ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z
ARG MINIO_SHA256_AMD64=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f
ARG MINIO_SHA256_ARM64=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d

RUN apk add --no-cache ca-certificates wget \
    && case "$TARGETARCH" in \
         amd64) minio_arch=amd64; checksum="$MINIO_SHA256_AMD64" ;; \
         arm64) minio_arch=arm64; checksum="$MINIO_SHA256_ARM64" ;; \
         *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && wget -q "https://dl.min.io/server/minio/release/linux-${minio_arch}/archive/minio.${MINIO_RELEASE}" -O /usr/local/bin/minio \
    && echo "$checksum  /usr/local/bin/minio" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/minio \
    && apk del wget

EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
